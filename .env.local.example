# Clerk — configure both keys in the Clerk dashboard and in Render.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# OpenRouter — server-side only. Create a project-scoped key with a spending limit.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# Prisma/Postgres — server-side only.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Optional public app URL used for OpenRouter attribution.
APP_URL=http://localhost:3000

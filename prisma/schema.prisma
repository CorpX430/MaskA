generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserPreference {
  id            String   @id @default(cuid())
  clerkUserId   String   @unique
  defaultPersona String  @default("insightful")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Generation {
  id          String   @id @default(cuid())
  clerkUserId String
  tweetUrl    String?  @db.VarChar(2000)
  tweetText   String   @db.VarChar(2000)
  persona     String   @db.VarChar(32)
  reply       String   @db.VarChar(280)
  model       String   @db.VarChar(160)
  createdAt   DateTime @default(now())

  @@index([clerkUserId, createdAt])
}
